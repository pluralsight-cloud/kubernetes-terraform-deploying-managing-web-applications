node_modules/

# Terraform local cache and state (providers are downloaded by terraform init)
.terraform/
*.tfstate
*.tfstate.*

# Local Terraform inputs. The *.example files stay in git.
*.tfvars
!*.tfvars.example

# App backend config. Copy backend.hcl.example and fill in the account id.
backend.hcl
!backend.hcl.example
